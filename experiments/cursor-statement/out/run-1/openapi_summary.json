        "customerNo"
      ],
      "data_fields": [
        "customerNo"
      ]
    },
    {
      "operationId": "cards.balance",
      "method": "POST",
      "path": "/voice/v1/cards.balance",
      "data_required": [
        "cardNumber"
      ],
      "data_fields": [
        "cardNumber"
      ]
    },
    {
      "operationId": "statement.week.get",
      "method": "POST",
      "path": "/voice/v1/statement.week.get",
      "data_required": [
        "cardNumber"
      ],
      "data_fields": [
        "cardNumber"
      ]
    },
    {
      "operationId": "statement.week.decide",
      "method": "POST",
      "path": "/voice/v1/statement.week.decide",
      "data_required": [
        "cardNumber",
        "newStatementWeek",
        "statementDay"
      ],
      "data_fields": [
        "cardNumber",
        "newStatementWeek",
        "statementDay"
      ]
    },
    {
      "operationId": "statement.week.change",
      "method": "POST",
      "path": "/voice/v1/statement.week.change",
      "data_required": [
        "cardNumber",
        "newStatementWeek",
        "statementDay"
      ],
      "data_fields": [
        "cardNumber",
        "newStatementWeek",
        "statementDay"
      ]
    },
    {
      "operationId": "contact.email.get",
      "method": "POST",
