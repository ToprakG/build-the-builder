      "data_required": [
        "customerNo",
        "intAddressInfoType"
      ],
      "data_fields": [
        "customerNo",
        "intAddressInfoType"
      ]
    },
    {
      "operationId": "statement.pdf.send",
      "method": "POST",
      "path": "/voice/v1/statement.pdf.send",
      "data_required": [
        "customerNo",
        "cardNumber",
        "currencyType",
        "statementDate",
        "emailAddress"
      ],
      "data_fields": [
        "customerNo",
        "cardNumber",
        "currencyType",
        "statementDate",
        "emailAddress"
      ]
    },
    {
      "operationId": "oauth2.token",
      "method": "POST",
      "path": "/oauth2/token",
      "data_required": [],
      "data_fields": []
