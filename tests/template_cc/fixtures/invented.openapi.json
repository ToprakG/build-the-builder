{
 "openapi": "3.0.3",
 "info": {
  "title": "Quillmoor tools",
  "version": "1"
 },
 "servers": [
  {
   "url": "https://quillmoor.invalid/api"
  }
 ],
 "paths": {
  "/verify_identity": {
   "post": {
    "operationId": "verify_identity",
    "summary": "Check one answer.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "question": {
          "type": "string",
          "enum": [
           "birth_date",
           "pin_last3"
          ]
         },
         "reply": {
          "type": "string",
          "description": "birth_date as YYYY-MM-DD; pin_last3 three digits"
         }
        },
        "required": [
         "customer_id",
         "question",
         "reply"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "verified": {
           "type": "boolean"
          },
          "tries_left": {
           "type": "integer"
          },
          "all_verified": {
           "type": "boolean"
          },
          "hint": {
           "type": "string",
           "enum": [
            "order_mixed"
           ]
          }
         },
         "required": []
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "operationId": "get_account",
    "summary": "The late items.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         }
        },
        "required": [
         "customer_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "items": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "item_ref": {
              "type": "string"
             },
             "kind": {
              "type": "string",
              "enum": [
               "kind_a",
               "kind_b"
              ]
             },
             "ending": {
              "type": "string"
             },
             "overdue": {
              "type": "number"
             },
             "days_over": {
              "type": "integer"
             },
             "floor_amount": {
              "type": "number"
             }
            },
            "required": []
           }
          }
         },
         "required": []
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "operationId": "create_promise",
    "summary": "Record a promise.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "item_ref": {
          "type": "string"
         },
         "amount_minor": {
          "type": "integer",
          "description": "amount in cents"
         },
         "pay_on": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "item_ref",
         "amount_minor",
         "pay_on"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_id": {
           "type": "string"
          }
         },
         "required": []
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "operationId": "add_note",
    "summary": "Note an item.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "item_ref": {
          "type": "string"
         },
         "code": {
          "type": "string",
          "enum": [
           "nx_refused",
           "nx_hard",
           "nx_dispute",
           "nx_paid",
           "nx_error"
          ]
         }
        },
        "required": [
         "customer_id",
         "item_ref",
         "code"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         },
         "required": []
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "operationId": "schedule_callback",
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "slot": {
          "type": "string",
          "description": "YYYY-MM-DDTHH:MM"
         }
        },
        "required": [
         "customer_id",
         "slot"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         },
         "required": []
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "operationId": "transfer_to_agent",
    "summary": "Transfer.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "desk": {
          "type": "string",
          "enum": [
           "desk_rework",
           "desk_person",
           "desk_care"
          ]
         }
        },
        "required": [
         "customer_id",
         "desk"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         },
         "required": []
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "operationId": "close_call",
    "summary": "Close.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "result": {
          "type": "string",
          "enum": [
           "kept",
           "settled",
           "handed_over",
           "no_deal",
           "unverified",
           "unreached"
          ]
         },
         "detail": {
          "type": "string",
          "enum": [
           "rework",
           "person",
           "care",
           "said_no",
           "hard_times",
           "contested",
           "fault",
           "wrong_answers",
           "would_not_answer",
           "later",
           "no_later",
           "not_theirs",
           "passed_away",
           "unsure"
          ]
         }
        },
        "required": [
         "customer_id",
         "result"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         },
         "required": []
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  }
 }
}
