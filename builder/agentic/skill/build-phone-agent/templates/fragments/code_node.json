{
 "name": "mark_not_their_line",
 "node_type": "code",
 "passthrough": true,
 "passthrough_default_transition": "goodbye_short",
 "on_enter": {
  "type": "silent"
 },
 "disable_inactivity_monitor": true,
 "pre_actions": [
  {
   "type": "function",
   "function": {
    "name": "code_exec",
    "handler": "__function__:code_exec",
    "parameters": {
     "type": "object",
     "properties": {
      "code": {
       "type": "string",
       "default": "try:\n    vars['close_outcome'] = 'outcome_w'\n    vars['close_detail'] = 'detail_b'\nexcept Exception:\n    pass\n"
      },
      "timeout_ms": {
       "type": "number",
       "default": 10000
      }
     }
    }
   }
  }
 ],
 "transitions": [
  {
   "target_node": "goodbye_short",
   "description": "always",
   "condition": {
    "operator": "always"
   }
  }
 ]
}
