{
 "name": "confirm",
 "node_type": "conversation",
 "on_enter": {
  "type": "tts",
  "text": "{{readback_text}}"
 },
 "task_message": "You read back the agreed payments. Wait for a clear yes. No tool call is allowed except end_call after a goodbye.",
 "tools": [
  {
   "type": "function",
   "config": {
    "timeoutMs": 10000
   },
   "function": {
    "name": "end_call",
    "handler": "__function__:end_call",
    "description": "Ends the call. CALL it right after you said goodbye, with no other text.",
    "parameters": {
     "type": "object",
     "properties": {
      "message_mode": {
       "type": "string",
       "default": "none"
      }
     }
    }
   }
  }
 ],
 "extraction_schema": [
  {
   "name": "confirm_answer",
   "type": "string",
   "enum_values": [
    "stay",
    "yes",
    "change"
   ],
   "description": "yes for a clear confirmation, change when the customer wants to change something, else stay.",
   "min_confidence": 0.7
  }
 ],
 "max_node_turns": 4,
 "max_turn_transition": "goodbye",
 "transitions": [
  {
   "target_node": "record_next",
   "description": "Confirmed",
   "condition": {
    "logic": "or",
    "conditions": [
     {
      "variable": "confirm_answer",
      "operator": "equals",
      "operand": "yes"
     }
    ]
   }
  },
  {
   "target_node": "reset_agreements",
   "description": "Wants a change",
   "condition": {
    "logic": "or",
    "conditions": [
     {
      "variable": "confirm_answer",
      "operator": "equals",
      "operand": "change"
     }
    ]
   }
  }
 ]
}
