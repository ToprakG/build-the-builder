{
 "name": "asks_robot",
 "node_type": "conversation",
 "description": "The customer asks whether they talk to a robot",
 "condition": {
  "operator": "matches_intent",
  "description": "The user asks whether they are talking to a robot, a machine or an AI"
 },
 "task_message": "Say you are Example Bank's automated assistant.",
 "on_enter": {
  "type": "tts",
  "text": "I am Example Bank's automated assistant."
 },
 "passthrough": true,
 "passthrough_default_transition": "__previous__",
 "excluded_nodes": [
  "setup",
  "mark_not_their_line",
  "third_party_prep",
  "id_failed",
  "load_account",
  "account_error",
  "facts",
  "difficulty_prep",
  "next_offer",
  "store_agreement",
  "reset_agreements",
  "record_next",
  "record_one",
  "note_one",
  "goodbye_recorded",
  "goodbye_not_recorded",
  "goodbye",
  "goodbye_short",
  "goodbye_failed",
  "goodbye_error",
  "goodbye_transfer"
 ],
 "transitions": [
  {
   "target_node": "__previous__",
   "description": "always",
   "condition": {
    "operator": "always"
   }
  }
 ]
}
