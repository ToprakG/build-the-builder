{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "T-CC policy.json",
 "description": "Canonical keys and types of the testbed config.json shape, plus T-CC additions (call_variables, lines, attempt_plan, weekday_words, retries, ask_limits, routes, extra_rules, _source, _overrides). Keys and types only; no brief values.",
 "type": "object",
 "required": ["bank", "language", "address", "identity", "callback", "outcome_map", "queue_map", "note_map", "close_rule",
              "notes_on_restructuring", "product_types", "account_fields", "product_id_format", "tools", "sentences",
              "forbidden_before_verify", "multi_product", "max_products", "attempt1", "holidays", "bands"],
 "properties": {
  "bank": {"type": "string", "minLength": 1},
  "language": {"type": "string", "minLength": 2},
  "currency": {"type": ["string", "null"]},
  "address": {"type": "string"},
  "identity": {
   "type": "object",
   "required": ["questions", "max_wrong", "swap_hint"],
   "properties": {
    "questions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "max_wrong": {"type": "integer", "minimum": 1},
    "swap_hint": {"type": "boolean"},
    "prompts": {"type": "object", "additionalProperties": {"type": "string"}},
    "kinds": {"type": "object", "additionalProperties": {"type": "string", "enum": ["date", "year", "digits", "code", "text"]}}
   }
  },
  "callback": {
   "type": "object",
   "required": ["start", "end", "same_day"],
   "properties": {
    "start": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
    "end": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
    "same_day": {"type": "boolean"}
   }
  },
  "outcome_map": {"type": "object", "additionalProperties": {"type": ["array", "null"], "items": {"type": ["string", "null"]}, "minItems": 2, "maxItems": 2}},
  "queue_map": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
  "note_map": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
  "close_rule": {
   "type": "object",
   "required": ["kind"],
   "properties": {
    "kind": {"type": "string", "enum": ["first_non_paid", "priority", "single"]},
    "order": {"type": "array", "items": {"type": "string"}}
   }
  },
  "notes_on_restructuring": {"type": ["string", "null"]},
  "product_types": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["enum", "label", "floor_field", "last4_field"],
    "properties": {
     "enum": {"type": "string"},
     "label": {"type": "string"},
     "floor_field": {"type": "string"},
     "last4_field": {"type": ["string", "null"]}
    }
   }
  },
  "account_fields": {
   "type": "object",
   "required": ["product_id", "type", "past_due", "days_late"],
   "additionalProperties": {"type": "string"}
  },
  "product_id_format": {"type": "string"},
  "tools": {
   "type": "object",
   "required": ["verify_identity", "create_promise", "schedule_callback", "close_call", "transfer_to_agent", "add_note"],
   "properties": {
    "verify_identity": {"type": "object", "required": ["field", "answer"], "additionalProperties": {"type": "string"}},
    "create_promise": {
     "type": "object",
     "required": ["product_id", "amount", "date", "amount_unit"],
     "properties": {"amount_unit": {"type": "string", "enum": ["currency", "cents"]}},
     "additionalProperties": {"type": "string"}
    },
    "schedule_callback": {
     "type": "object",
     "required": ["mode"],
     "properties": {"mode": {"type": "string", "enum": ["date_time", "datetime"]}},
     "additionalProperties": {"type": "string"}
    },
    "close_call": {
     "type": "object",
     "required": ["mode"],
     "properties": {"mode": {"type": "string", "enum": ["outcome_reason", "code"]}},
     "additionalProperties": {"type": "string"}
    },
    "transfer_to_agent": {"type": "object", "required": ["queue"], "additionalProperties": {"type": "string"}},
    "add_note": {"type": "object", "required": ["product_id", "reason"], "additionalProperties": {"type": "string"}}
   }
  },
  "sentences": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
  "forbidden_before_verify": {"type": "array", "items": {"type": "string"}},
  "multi_product": {"type": "boolean"},
  "max_products": {"type": "integer", "minimum": 1},
  "attempt1": {"type": "string"},
  "holidays": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}},
  "bands": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["name", "min_days", "max_days", "deadline_business_days", "attempts"],
    "properties": {
     "name": {"type": "string"},
     "min_days": {"type": "integer", "minimum": 0},
     "max_days": {"type": "integer", "minimum": 0},
     "deadline_business_days": {"type": "integer", "minimum": 0},
     "attempts": {"type": "integer", "minimum": 0}
    }
   }
  },
  "call_variables": {"type": "array", "items": {"type": "string"}},
  "unused_tools": {"type": "array", "items": {"type": "string"}},
  "lines": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": ["text", "verbatim"],
    "properties": {"text": {"type": "string"}, "verbatim": {"type": "boolean"}, "_source": {"type": "string"}}
   }
  },
  "attempt_plan": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["date", "amount"],
    "properties": {
     "date": {"type": "string", "enum": ["end_of_week_roll", "end_of_week", "deadline", "today", "next_business_day"]},
     "amount": {"type": "string", "enum": ["full_or_floor", "full", "floor"]},
     "cap_at_deadline": {"type": "boolean"}
    }
   }
  },
  "weekday_words": {
   "type": "object",
   "properties": {
    "next": {"type": "string", "enum": ["following_week", "next_occurrence"]},
    "this": {"type": "string", "enum": ["current_week", "next_occurrence"]}
   }
  },
  "retries": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
  "ask_limits": {"type": "object", "description": "Counts. id_decline = the number of times the agent re-asks after the FIRST refusal of an identity question (the explanation is said once, on the first refusal); the call closes on refusal number id_decline + 1. 'Explain once, close after the second refusal' -> id_decline = 1.", "additionalProperties": {"type": "integer", "minimum": 0}},
  "precedence": {"type": "array", "items": {"type": "string", "enum": ["wants_human", "asks_scam", "asks_robot", "finished", "goodbye"]}},
  "vague_date_offer": {"type": "string", "enum": ["deadline", "attempt1", "other"]},
  "routes": {"type": "object", "properties": {"human_before_verify": {"type": "boolean"}}, "additionalProperties": {"type": "object"}},
  "extra_rules": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["statement"],
    "properties": {
     "statement": {"type": "string"},
     "brief_quote": {"type": "string"},
     "stage": {"type": "string", "enum": ["opening", "third_party", "identity", "debt", "negotiate", "close", "global"]}
    }
   }
  },
  "intents": {"type": "object", "properties": {
   "hardship": {"type": "object", "required": ["definition"], "properties": {"definition": {"type": "string"}, "examples": {"type": "array", "items": {"type": "string"}}, "near_misses": {"type": "array", "items": {"type": "string"}}, "_source": {"type": "string"}}},
   "dispute": {"type": "object", "required": ["definition"], "properties": {"definition": {"type": "string"}, "examples": {"type": "array", "items": {"type": "string"}}, "near_misses": {"type": "array", "items": {"type": "string"}}, "_source": {"type": "string"}}},
   "paid_already": {"type": "object", "required": ["definition"], "properties": {"definition": {"type": "string"}, "examples": {"type": "array", "items": {"type": "string"}}, "near_misses": {"type": "array", "items": {"type": "string"}}, "_source": {"type": "string"}}},
   "restructuring": {"type": "object", "required": ["definition"], "properties": {"definition": {"type": "string"}, "examples": {"type": "array", "items": {"type": "string"}}, "near_misses": {"type": "array", "items": {"type": "string"}}, "_source": {"type": "string"}}},
   "discount": {"type": "object", "required": ["definition"], "properties": {"definition": {"type": "string"}, "examples": {"type": "array", "items": {"type": "string"}}, "near_misses": {"type": "array", "items": {"type": "string"}}, "_source": {"type": "string"}}},
   "human": {"type": "object", "required": ["definition"], "properties": {"definition": {"type": "string"}, "examples": {"type": "array", "items": {"type": "string"}}, "near_misses": {"type": "array", "items": {"type": "string"}}, "_source": {"type": "string"}}},
   "stop_talking": {"type": "object", "required": ["definition"], "properties": {"definition": {"type": "string"}, "examples": {"type": "array", "items": {"type": "string"}}, "near_misses": {"type": "array", "items": {"type": "string"}}, "_source": {"type": "string"}}},
   "refusal": {"type": "object", "required": ["definition"], "properties": {"definition": {"type": "string"}, "examples": {"type": "array", "items": {"type": "string"}}, "near_misses": {"type": "array", "items": {"type": "string"}}, "_source": {"type": "string"}}},
   "callback_request": {"type": "object", "required": ["definition"], "properties": {"definition": {"type": "string"}, "examples": {"type": "array", "items": {"type": "string"}}, "near_misses": {"type": "array", "items": {"type": "string"}}, "_source": {"type": "string"}}}
  }},
  "_source": {"type": "object", "additionalProperties": {"type": "string"}},
  "_overrides": {"type": "array", "items": {"type": "object"}}
 }
}
